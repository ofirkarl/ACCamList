{
  "name": "AC Cam List",
  "short_name": "AC Cam List",
  "description": "Camera equipment lists for camera assistants",
  "lang": "en",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#f6f4f0",
  "share_target": {
    "action": "./?share-target=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"title": "title", "text": "text", "files": [{"name": "file", "accept": ["application/pdf", ".pdf", "image/*"]}]}
  },
  "icons": [
    {"src": "icons/icon-192-v5.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512-v5.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/maskable-512-v5.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
